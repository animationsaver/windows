#!/bin/bash
# root で呼ばれ、overlay の merged をルートにして元のユーザ・元のグループでコマンドを実行する。
set -u
ROOT="${ENVSNAP_ROOT:-/mnt/envsnap}"
MERGED="$ROOT/merged"
U="${SUDO_USER:-runner}"
[ -d "$MERGED/usr" ] || exec /bin/bash "$@"
GROUPS_CSV="$(id -Gn "$U" 2>/dev/null | tr ' ' ',')"
exec chroot --userspec="$U:$U" ${GROUPS_CSV:+--groups="$GROUPS_CSV"} "$MERGED" /usr/bin/env \
  ENVSNAP_INSIDE=1 HOME="/home/$U" USER="$U" LOGNAME="$U" SHELL=/bin/bash \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  /bin/bash -c 'cd "$HOME" 2>/dev/null || cd /; if [ "$#" -eq 0 ]; then exec /bin/bash -l; fi; exec /bin/bash "$@"' envsnap-enter "$@"
