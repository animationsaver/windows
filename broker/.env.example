# ---------------------------------------------------------------------------
# Broker configuration. Copy to broker/.env and fill in.
# ---------------------------------------------------------------------------

# Fine-grained PAT scoped to THIS repository only, with Actions: Read & write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
# Both optional. Leave them out and the broker asks GitHub who the token
# above belongs to, and which repository it is scoped to.
# GITHUB_OWNER=<your-github-account>
# GITHUB_REPO=<your-repo>
WORKFLOW_FILE=ephemeral-env.yml
# Used when create_env is called with platform=macos.
WORKFLOW_FILE_MACOS=ephemeral-env-macos.yml
# Used when create_env is called with platform=windows.
WORKFLOW_FILE_WINDOWS=ephemeral-env-windows.yml
# workflow_dispatch only works for workflows on the default branch.
WORKFLOW_REF=main

# Your tailnet's MagicDNS domain, without a leading dot.
# Find it with: tailscale status --json | jq -r .MagicDNSSuffix
TAILNET_DOMAIN=tailXXXX.ts.net

# Hostname(s) clients use to reach this broker, comma separated, no scheme.
# The MCP SDK validates the Host header and answers 421 Misdirected Request
# for anything unlisted, so this must match the funnel hostname.
# Leave empty to skip Host validation entirely (the bearer token still applies).
BROKER_PUBLIC_HOSTS=oracle-ubuntu-03.tailXXXX.ts.net

# Account the broker logs in as on the environment. Tailscale SSH authorises
# the connection by tailnet identity, so no key or password is configured.
SSH_USER=runner
SSH_PORT=22
# macOS runners have no Tailscale SSH server, so those environments run
# their own sshd on this port, published on the tailnet with
# `tailscale serve --tcp`. Authentication is a throwaway keypair the
# broker mints per environment, so there is still nothing to configure.
SSH_PORT_MACOS=2222
# Windows runners have no Tailscale SSH server either, so those
# environments run the Windows OpenSSH service on this port with an
# inbound rule that only lets the tailnet in. The account differs from
# the other two platforms: GitHub's Windows images log in as
# runneradmin, and that session is already elevated.
SSH_PORT_WINDOWS=2222
SSH_USER_WINDOWS=runneradmin
SSH_CONNECT_TIMEOUT=20

# Loopback port Playwright MCP binds on the runner. The broker reaches it
# through an SSH port forward; it is never published on the tailnet.
PW_MCP_PORT=8931

# How many environments may be alive at once. Each one holds a GitHub Actions
# job for its whole TTL, so the ceiling is the concurrent-job allowance of the
# account that OWNS this repository -- not of whoever's token dispatched the
# run, which is why a second collaborator's PAT adds nothing. ACTIONS_PLAN
# selects the right pair of numbers:
#
#   plan         total jobs   of which macOS
#   free                 20                5
#   pro                  40                5
#   team                 60                5
#   enterprise          500               50
#
# Leave MAX_ENVS and MAX_ENVS_MACOS unset to use the whole allowance.
ACTIONS_PLAN=free
# Jobs held back for workflows that are not environments (broker image build,
# CI). 0 gives environments the entire plan; 2 or 3 keeps a lane open so a full
# broker cannot block the workflow that ships its own next release.
RESERVED_JOB_SLOTS=0
# MAX_ENVS=20
# MAX_ENVS_MACOS=5
DEFAULT_TTL_MINUTES=350

# Ceiling, in seconds, on the calls that block: exec, sudo_exec, wait_ready
# and browser_call. This tracks the MCP CLIENT, not this server. A client
# abandons a request on its own schedule and never tells the server, so a
# longer call loses the result of a command that actually succeeded. Notion's
# client was measured at about 60s. Above the ceiling the broker refuses and
# points at exec_start/exec_poll, which detach the job on the environment and
# are unaffected. Raise it only for a client known to wait longer.
SYNC_EXEC_MAX_SECONDS=50
# Default number of trailing log lines exec_poll returns.
JOB_TAIL_LINES=200

# Shared bearer token that Notion (or any MCP client) must present.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BROKER_TOKEN=change-me-to-a-long-random-string

# Image used by docker-compose.yml. Required; ghcr paths are lowercase only.
BROKER_IMAGE=ghcr.io/<your-github-account>/<your-repo>/broker:latest

DB_PATH=/data/broker.sqlite3
