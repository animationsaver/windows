# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT scoped to this repository only, with:
#   Actions: Read and write   (needed for workflow_dispatch)
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=animationsaver
GITHUB_REPO=windows
WORKFLOW_FILE=ephemeral-env.yml
# workflow_dispatch only works for workflows present on the default branch.
WORKFLOW_REF=main

# --- Tailscale --------------------------------------------------------------
# Your tailnet's MagicDNS suffix, e.g. tail1a2b3.ts.net
TAILNET_DOMAIN=tailXXXXX.ts.net

# --- Broker -----------------------------------------------------------------
# Shared bearer token required to talk to the broker at all.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
BROKER_TOKEN=change-me

# Number of parallel environments (also the number of reusable hostnames
# gha-env-01 .. gha-env-NN). Keep it small: each hostname needs its own
# Let's Encrypt certificate, and Actions caps concurrent jobs per account.
SLOT_COUNT=6

DEFAULT_TTL_MINUTES=350
DB_PATH=/data/broker.sqlite3
